build/
# LZ4 的 build/ 是上游构建脚本源码，不是本地构建产物。
!third_party/lz4-1.10.0/build/
.vs/
*.user
*.pro.user
.idea/
CMakeUserPresets.json
CMakeLists.txt.user
cmake-build-debug/
cmake-build-release/
cmake-build-relwithdebinfo/
Install/

# SSH 第三方库构建产物（源码树保留，构建/安装前缀不入库）
third_party/openssl-3.5.7/build/
third_party/openssl-3.5.7/install/
third_party/libssh-0.12.2/build/
third_party/libssh-0.12.2/out/

# 性能分析产物（本地生成，不入库）
perf.data*
perf.txt

# Generated benchmark/test text output (keep source and environment notes)
/tests/**/*.txt
!/tests/**/CMakeLists.txt
!/tests/**/requirements.txt
!/tests/benchmarks/**/sampled-tests-CMakeLists.txt
!/tests/benchmarks/**/cpu-topology.txt
