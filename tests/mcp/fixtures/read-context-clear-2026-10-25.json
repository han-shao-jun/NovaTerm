        "additionalProperties": false,
        "properties": {
            "epoch": {
                "maxLength": 64,
                "type": "string"
            },
            "expandToken": {
                "maxLength": 4096,
                "type": "string"
            },
            "includeViewport": {
                "default": true,
                "type": "boolean"
            },
            "maxBytes": {
                "default": 65536,
                "maximum": 262144,
                "minimum": 1,
                "type": "integer"
            },
            "maxLines": {
                "default": 256,
                "maximum": 1024,
                "minimum": 1,
                "type": "integer"
            },
            "responseMode": {
                "enum": [
                    "compact",
                    "full"
                ],
                "type": "string"
            },
            "sessionId": {
                "maxLength": 36,
                "type": "string"
            },
            "sinceToken": {
                "maxLength": 1024,
                "type": "string"
            },
            "waitFor": {
                "enum": [
                    "attention",
                    "completion",
                    "change"
                ],
                "type": "string"
            },
            "waitMs": {
                "default": 0,
                "maximum": 30000,
                "minimum": 0,
                "type": "integer"
            },
            "source": {
                "type": "string",
                "enum": [
                    "observation",
                    "log"
                ]
            },
            "start": {
                "type": "string",
                "enum": [
                    "tail",
                    "oldest"
                ]
            }
        },
        "required": [
            "sessionId",
            "epoch"
        ],
        "type": "object"
    },
