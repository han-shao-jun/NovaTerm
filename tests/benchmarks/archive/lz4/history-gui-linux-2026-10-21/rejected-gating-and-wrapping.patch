+        _historyFrameWaiting = false;
+        if (_paintingEnabled && _scrollLine > 0) {
+            // Start bounded CacheOnly work while the normal frame scheduler
+            // is waiting, rather than first discovering cold blocks inside a
+            // GPU pass which then submits the old viewport. The snapshot and
+            // pins are local; no second history cache/owner survives this call.
+            const auto history = _core->scrollbackSnapshot();
+            (void)NovaTerm::LineLayout::viewport(history, _scrollAnchorLine,
+                _scrollAnchorWrap, std::max(1, _commandBuffer.columns()),
+                std::min(_scrollLine, std::max(1, _commandBuffer.rows())), 0,
+                history.version(), NovaTerm::HistoryReadMode::CacheOnly);
